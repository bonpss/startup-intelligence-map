MISTRAL_API_KEY=
# TypeSafe AI (Jev) -- used by competitor.py's Jev scoring path and by
# shadow_classify_sector.py's shadow comparison. https://typesafe.ai
TYPESAFE_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
# Cloudflare R2 -- stores favicon/logo assets (main.py::fetch_and_save_favicon/
# fetch_and_save_real_logo), replacing local assets/logos/ so images survive
# across dev machines and the VPS. R2_PUBLIC_URL has no trailing slash.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
SESSION_SECRET_KEY=
OWNER_EMAIL=
# Non-owner signup cap. Blank/unset = 0 = signups closed, not unlimited.
MAX_USERS=
# Set to "true" once the demo is deployed behind HTTPS (defaults to false so
# the session cookie still works over http://localhost during development).
SESSION_COOKIE_HTTPS_ONLY=
